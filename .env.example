# =====================================================================
# 云校园自动化 (Automatic CloudCampus) — 环境变量示例
# 复制成仓库根目录的 .env 后按需填写；.env 已在 .gitignore 中，不会被提交。
# 所有变量名与 backend/app/config.py 的 Settings 字段一一对应，
# 也兼容旧的 AUTOCC_ 前缀写法（AUTOCC_ADMIN_PASSWORD 等价于 ADMIN_PASSWORD）。
# =====================================================================

# ---------- 管理员（后台 /admin）----------
# 留空表示关闭管理后台登录校验，请务必在生产环境设置强口令
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 站点 / 跨域 ----------
# 允许跨域的前端来源，逗号分隔。留空则仅允许本地开发地址
# 例: https://your-domain.example
CORS_ORIGINS=
# 只接受这些 Host 头的请求，留空表示不限制
TRUSTED_HOST=
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=60

# ---------- 支付（易支付 zpayz）----------
# 需要在 zpayz 后台申请商户号与密钥；留空则支付功能关闭
PAYMENT_PID=
PAYMENT_KEY=
PAYMENT_SITENAME=AutoCC
PAYMENT_BASE_PRICE=20
# 支付回调与跳转地址必须填写公网可访问的域名
PAYMENT_NOTIFY_PATH=https://your-domain.example/api/payment/notify
PAYMENT_RETURN_URL=https://your-domain.example/dashboard
ZPAY_API_URL=https://zpayz.cn/mapi.php
ZPAY_ORDER_QUERY_URL=https://zpayz.cn/api.php?act=order

# ---------- 云校园站点 ----------
CLOUDCAMPUS_BASE=https://www.cloudcampus.com.cn
GRADE_URL_TEMPLATE={base}/grade/report/user/index.php?id={course_id}
MANUAL_MARK_URL=https://www.cloudcampus.com.cn/lib/ajax/service.php
DEFAULT_COURSE_ID=11881
# 默认排除的任务（逗号分隔的任务 ID），留空表示不排除
DEFAULT_EXCLUDED_TASKS=

# ---------- 对外展示 ----------
# 前端「联系客服」按钮使用的邮箱，会公开显示
CONTACT_EMAIL=support@example.com

# ---------- 旧版 CLI（legacy/autocc-cli）用到的可选变量 ----------
# Edge WebDriver 路径；留空则由 Selenium Manager 自动下载
EDGEDRIVER_PATH=
# 抓包目录；留空则使用仓库根目录的 Raw/
AUTOCC_RAW_DIR=
